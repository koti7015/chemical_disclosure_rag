{
  "info": {
    "name": "Chemical Disclosure RAG",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "sql_records and vector_records should both be 96 after ingest"
          }
        },
        {
          "name": "Ingest sample",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/ingest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "description": "Choose data/sample_100.xlsx in the 'file' field. First time: loaded, 96 rows. Second time: already_loaded"
          }
        },
        {
          "name": "Ingest wrong file type",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/ingest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "description": "Choose README.md. Expect 400"
          }
        }
      ]
    },
